    <!-- 桌面快捷方式 -->
    <Component Id="CmpDesktopShortcut" Directory="DesktopFolder" Guid="A1B2C3D4-E5F6-7890-1234-567890ABD001">
      <Shortcut Id="DesktopShortcut" Name="Neko 桌宠" Description="Neko 桌宠"
                Target="[INSTALLFOLDER]Neko.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveDesktopShortcut" Directory="DesktopFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Neko" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- 开始菜单快捷方式 -->
    <Component Id="CmpStartMenuShortcut" Directory="NekoProgramMenu" Guid="A1B2C3D4-E5F6-7890-1234-567890ABD002">
      <Shortcut Id="StartMenuShortcut" Name="Neko 桌宠" Description="Neko 桌宠"
                Target="[INSTALLFOLDER]Neko.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenuDir" Directory="NekoProgramMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Neko" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- 开机自启（默认不装，Feature Level=2） -->
    <Component Id="CmpAutoStart" Directory="INSTALLFOLDER" Guid="A1B2C3D4-E5F6-7890-1234-567890ABD003">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="NekoDeskPet" Value="&quot;[INSTALLFOLDER]Neko.exe&quot;" Type="string" KeyPath="yes" />
    </Component>

