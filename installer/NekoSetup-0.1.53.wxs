    <!-- 注意：WiX 4 的 StandardDirectory/Component/Feature 必须放 Package 内（不是 Fragment！） -->
    <!-- 目录布局：%LOCALAPPDATA%\Neko（文件主体）+ 桌面 + 开始菜单 -->
