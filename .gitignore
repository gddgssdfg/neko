# ===== 构建产物（不入库；bin/obj 是递归匹配，builtins/ 下的产物也覆盖）=====
bin/
obj/
*.user
*.suo
.vs/

# ===== 发布与安装包（体积巨大，可重新生成）=====
# publish/ 累积 4.1G（含历史自包含 Neko.exe 单文件 170MB × N 版本）
publish/
# installer/ 累积 375M（历史 MSI 各 54MB）
installer/*.msi
installer/*.wixpdb
installer/*.exe
installer/tmp_*.wixpdb

# ===== 运行时数据（用户配置/插件数据，不入库）=====
data/

# ===== 素材备份与中间产物 =====
neko-assets.bak-*/
*.bak-*
*_preview*.png
neko-assets/soft/preview.png
# 托盘图标制作的中间产物（原始素材与抠图草稿）
neko-assets/_icon_*

# ===== AI 生图原图（v0.1.81：豆包等生成的高清原图，体积大、只作切图输入，不进仓库）=====
neko-assets/_airaw/

# ===== 真机验证截图临时产物（v0.1.81：tools/capture_pet.py 抓的图，仅本机调试用）=====
# 只忽略仓库根的这两个前缀，不用 *.png 通配（neko-assets/ 下的素材 PNG 要进仓库）
/_live_shot*.png
/_win_*.png

# ===== 其余调试/核对产物（v0.1.82：素材体检图、菜单判读图、皮肤预览页等）=====
# 同样只列仓库根的具体前缀，绝不用 *.png 通配（否则会漏掉 neko-assets 里的素材）
/_assets_contact.png
/_icons_compare.png
/_icons_prev_direction.png
/_menu_*.png
/_pixelai_live.png
/_qa_*.png
/_radial_shot.png
/_settings_*.png
/_scroll_*.png
/_gaze_*.png
/_kb_*.png
/_cmp_*.png
/_icons_ports*.png
/_preview_skins.html

# ===== 测试备用输出目录（v0.1.82：沙箱里旧 UiProbe 进程锁住 bin/ 时的绕法，见 dev-log）=====
bin_alt*/
bin_final*/
bin_smoke*/

# ===== 本地一键 CI 产物（tools/ci.py 用 -p:BaseOutputPath=bin_ci/ 隔离，避免锁住常规 bin/）=====
bin_ci*/

# ===== Python 工具链缓存（项目在 tools/、installer/ 下用 Python 脚本）=====
__pycache__/
*.pyc

# ===== 安装器生成物（gen_setup_wxs.py 每次出包重写，不入库）=====
installer/*.wxs
installer/*.wixpdb

# ===== 测试工具的运行产物（tests/ClipHarness 每次跑会重写）=====
tests/ClipHarness/out.txt

# ===== 协作临时文件（teammate 排查用，别入库）=====
gitstat.txt
_gitstatus_tmp.txt

# ===== 编辑器 / 系统 =====
.vscode/
.workbuddy/
Thumbs.db
Desktop.ini
*.log

# ===== 密钥（⚠️ 绝不入库）=====
.env
*.key
!*.pub

# ===== 插件部署产物（从 builtins/ 构建部署，不入库）=====
# plugins/com.lantern.*/ 由各内置插件的 DeployToPlugins target 生成（dll + 从 builtins/ 拷来的 manifest）。
# 插件 dll 属非确定性构建（源码不变、重建也会内容微变）→ 入库会持续刷 diff 噪音。
# 手写内容（plugins/README.md、plugins/_template/）仍入库。
/plugins/com.lantern.*/
