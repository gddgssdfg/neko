  <ItemGroup>
    <!-- v0.1.78 P2-3：素材复制改「白名单」——只复制真运行时素材目录 + 托盘图标。
         旧实现用 ..\..\neko-assets\**\*.png 通配，把 _icon_clean.png(1.1MB)、*_preview*.png、
         reference\ 参考图等开发噪声一并复制进 publish → 进而被 MSI 打进安装包（与 P0-1 同源）。
         运行时经代码核对真正引用：
           · icons\**\*.png   —— RadialMenu 槽位图标缓存（RadialMenu.cs）
           · mirror\**\*.png  —— InputMirrorWindow 爪子素材 paw_up/paw_down
           · <skin>\**        —— SkinRegistry 扫 <skin>\skin.json 发现皮肤（pixel/soft）及帧图
           · tray.ico         —— TrayManager 托盘图标 + ApplicationIcon
         新增内置皮肤需在此补一行（用户自制皮肤放运行时 neko-assets，不受此影响）。
         ⚠️ v0.1.80 P0 修复：LinkBase 必须把子目录写进去（neko-assets\icons 而非仅 neko-assets）。
         MSBuild 的 LinkBase 会自动拼接 %(RecursiveDir)，而 %(RecursiveDir) 是相对「通配符基准目录」的——
         白名单把基准目录下移到 icons\ / pixel\ 等，若 LinkBase 仍只写 neko-assets，则 icons\book.png
         会被摊平到 neko-assets\book.png（丢一层目录）。运行时按 neko-assets/icons 定位 → 图标全丢。
         正确写法：LinkBase 补齐子目录，使 RecursiveDir 相对其后拼接，还原 v0.1.78 通配的目录结构。 -->
    <None Include="..\..\neko-assets\icons\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\icons" />
    <None Include="..\..\neko-assets\mirror\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\mirror" />
    <None Include="..\..\neko-assets\pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixel" />
    <None Include="..\..\neko-assets\soft\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\soft" />
    <!-- v0.1.81：AI 高清皮肤（由 tools/ai_sheet_to_skin.py 生成） -->
    <None Include="..\..\neko-assets\hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\hd" />
    <None Include="..\..\neko-assets\pixelai\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixelai" />
    <None Include="..\..\neko-assets\cat_pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\cat_pixel" />
    <None Include="..\..\neko-assets\cat_hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\cat_hd" />
    <None Include="..\..\neko-assets\phoebe_pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\phoebe_pixel" />
    <None Include="..\..\neko-assets\phoebe_hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\phoebe_hd" />
    <!-- 拼豆皮肤（第 9 套，仅"可被选到"；默认皮肤仍是 pixel，见 SkinRegistry.DefaultSkinId）。
         刻意用 *.png + skin.json 而非 **\*，把 bead/model/*.beads.json 排除在包外：
           · 运行时零依赖该模型 —— SkinRegistry 只扫 <skin>/skin.json；SpriteAtlas 只读
             neko_<state>.png / neko_<eye>.png / neko_shadow.png（均为 *.png）。
           · model/*.beads.json 是烘焙器（tools/bead）的**源模型/输入**，属构建期产物，不该进运行时包。
         与其它 8 套皮肤的目录结构不同（只有 bead 有 model/ 子目录），故此处白名单收窄而非照抄 **\*。 -->
    <None Include="..\..\neko-assets\bead\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\bead" />
    <None Include="..\..\neko-assets\bead\skin.json" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\bead" />
    <None Include="..\..\neko-assets\ui\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\ui" />
    <None Include="..\..\neko-assets\amber\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\amber" />
    <None Include="..\..\neko-assets\amber\skin.json" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\amber" />
    <None Include="..\..\neko-assets\tray.ico" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets" />
    <!-- 兜底：即便白名单目录里混入预览图 / *.bak-* 噪声，也一律剔除（与 gen_setup_wxs.py 规则对齐） -->
    <None Remove="..\..\neko-assets\**\*preview*" />
    <None Remove="..\..\neko-assets\**\*.bak-*" />
  </ItemGroup>

  <!-- v0.1.42 修复：target 改挂到 Build+Publish，之前的 AfterTargets="Build" 让 `dotnet publish` 不会触发，
       导致 publish/plugins/ 一直空——真机 Release 跑其实没装任何插件。
       PublishSingleFile=true 不会自动 copy 其他项目产物，必须显式复制。
       注意：Build 后复制到 $(OutDir)（F5 开发用）；Publish 后复制到 $(PublishDir)（发布产物用）——
       OutDir 与 PublishDir 是不同目录，只挂 Build 的话发布产物永远没插件。 -->
  <Target Name="DeployPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_PluginFiles Include="..\..\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFiles)"
          DestinationFiles="@(_PluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PluginFiles Include="..\..\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFiles)"
          DestinationFiles="@(_PluginFiles->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- v0.1.82：把「内置插件信任清单」接线到构建——
       构建后扫描**已部署**的 plugins/，生成 exe 同级的 builtins.lock.json（schema:1 + 各插件的
       plugin.toml / 入口 dll 的 SHA-256），供宿主 PluginTrustSet 放行官方内置插件的高风险权限声明。
       依赖 DeployPluginsToOutput（先有插件目录才扫描得到）。
       ⚠️ 必须 fail-safe：环境没有 Python / 脚本报错时只 WarnAndContinue，**绝不阻断构建**——
       清单缺失时宿主行为与旧版一致（一律不信任，安全兜底）。
       Python 解释器可用 -p:PythonExe=<path> 覆盖（缺省取 PATH 上的 python）。 -->
  <PropertyGroup>
    <PythonExe Condition="'$(PythonExe)' == ''">python</PythonExe>
  </PropertyGroup>

  <Target Name="GenerateBuiltinsLock" AfterTargets="Build" DependsOnTargets="DeployPluginsToOutput">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\tools\gen_builtins_lock.py&quot; --plugins-dir &quot;$(OutDir)plugins&quot; --output &quot;$(OutDir)builtins.lock.json&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="GenerateBuiltinsLockForPublish" AfterTargets="Publish" DependsOnTargets="DeployPluginsToPublish">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildThisFileDirectory)..\..\tools\gen_builtins_lock.py&quot; --plugins-dir &quot;$(PublishDir)plugins&quot; --output &quot;$(PublishDir)builtins.lock.json&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
