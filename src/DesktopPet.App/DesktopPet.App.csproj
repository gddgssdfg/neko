<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DesktopPet.App</RootNamespace>
    <AssemblyName>Neko</AssemblyName>

    <!-- 版本号（语义化版本，每次改动同步更新 CHANGELOG.md） -->
    <Version>0.2.6</Version>
    <ApplicationIcon>..\..\neko-assets\tray.ico</ApplicationIcon>

    <!-- 发布配置（v0.1.60：回自包含——用户零前置，双击即用；v0.1.57 曾被误改为 false 且无留痕）
         ⚠️ EnableCompressionInSingleFile 必须为 false：v0.1.60 实测对照——
            压缩 on  → 体积 80MB / 稳态内存 276MB（启动解压运行时，映射常驻内存）
            压缩 off → 体积 174MB / 稳态内存 177MB
         桌宠是常驻程序，内存优先 → 关压缩（灯灯 2026-09-11 拍板）
         若改回框架依赖需同步：MSI 加 .NET 8 Desktop Runtime 前置检测 + neko.iss 注释 -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- ⚠️ 必须用 PublishSelfContained，不能写 SelfContained（v0.1.82 血案）
         SelfContained 是**构建期**属性：写在这里会让 `dotnet build`(Debug) 也产出
         "自包含非单文件"形态，而该形态下 AssemblyDependencyResolver 直接失败——
         所有插件加载报 "Hostpolicy must be initialized and corehost_main must have been
         called before calling corehost_resolve_component_dependencies"（code -2147450750），
         表现为「右键菜单一个插件都没有」。PublishSelfContained 只影响 dotnet publish，
         Debug 保持框架依赖 → 插件正常；发布产物仍是自包含单文件。 -->
    <PublishSelfContained>true</PublishSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- v0.2.3：体积预算复核（A2）后的实测取舍 —— 关掉 ReadyToRun。
         三个变体实测（Release / 自包含单文件，各项同一台机）：
             R2R 开（旧）  exe 163.6 MiB · 常驻 WS 184.9 MiB · 冷启动中位 0.658s
             R2R 关（现）  exe 147.0 MiB · 常驻 WS 174.9 MiB · 冷启动中位 0.698s
         ⇒ 换掉 **16.6 MiB 体积 + 10.0 MiB 常驻内存**，代价 **+0.040s** 启动，而红线是 <2.0s（余量 >1.3s）。
         R2R 的收益本来就是"省 JIT"，但本项目启动耗时大头在**文件 I/O 与 WPF 初始化**，实测冷缓存首启
         两者 1.398s vs 1.380s（几乎无差）——所以这笔换算是划算的。另：R2R 的 native 映像在磁盘与内存里都更大。
         量尺：`python tools/measure_startup.py`（本次新增；此前这条红线**没有工具**，只能靠感觉）。 -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- v0.2.3：收窄卫星资源语言 —— 只保留 en 与 zh-Hans。
         实测未收窄时 **221 个 *.resources.dll 共 15.59 MiB**（ru/ja/de/ko/fr/pl/it/es/pt-BR/cs/tr/zh-Hant…），
         对一个只有中英双语的桌宠是纯浪费：单文件产物 exe 147.0 → **131.0 MiB**，目录 165 → **149 MiB**。
         ⚠️ **必须保留 zh-Hans**：WPF 框架自己的对话框文案（MessageBox 的「确定/取消」）来自
         PresentationFramework 的 zh-Hans 卫星资源 —— 裁掉它就变英文。
         ⚠️ 命令行传多值要写成 `-p:SatelliteResourceLanguages=en%3Bzh-Hans`，但实测 `%3B` 可能不被解码、
         结果**连 zh-Hans 一起丢**（本轮踩过）→ 只在这里（XML）写，别在命令行传。
         代价：非中英系统的用户会看到**英文的框架弹窗**（应用自身 UI 文案不受影响，它是代码里双语的）。 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <DebugType>embedded</DebugType>

    <!-- 性能：工作站负载，关并发回收 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\neko-assets\pixel_redraw\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixel_redraw" />
    <None Include="..\..\neko-assets\pixel_redraw\skin.json" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixel_redraw" />

    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
    <ProjectReference Include="..\DesktopPet.Runtime\DesktopPet.Runtime.csproj" />
    <!-- 引用 Sdk：确保宿主进程加载 DesktopPet.Sdk.dll，插件 ALC 才能把 Sdk 路由回宿主侧（类型分裂修复的关键） -->
    <ProjectReference Include="..\DesktopPet.Sdk\DesktopPet.Sdk.csproj" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <!-- ===== v0.1.82 修复：Debug/Publish 构建竞态 MSB3030 ============================================
       现象：`dotnet build src/DesktopPet.sln -c Debug` 偶发
             MSB3030「无法复制文件 ..\..\plugins\com.lantern.X\X.dll，原因是找不到该文件」，
             且报错插件每次都不同（screenshot / notes / todo …）。
       根因：下方 DeployPluginsToOutput / DeployPluginsToPublish 会读取【仓库根 plugins/】，而该目录由
             18 个内置插件的 DeployToPlugins（AfterTargets=Build）在各自构建后并发写入。在 .sln 并行构建中
             App 与各内置插件之间【没有】构建依赖，App 可能在某个插件正被并发覆盖的瞬间去读它，
             源文件瞬时不可用即触发 MSB3030。这是「读者读一个写者正在写的目录」的经典竞态，与具体插件无关
             （故报错插件随机）。
       修复：用 ProjectReference(ReferenceOutputAssembly=false) 在本宿主与全部内置插件之间建立【构建顺序依赖】：
             App（含其 AfterTargets=Build 的 DeployPluginsToOutput）必然在【全部】内置插件构建（及其
             DeployToPlugins）完成之后才执行，App 读 plugins/ 时目录已静止，竞态从根上消除。
             · ReferenceOutputAssembly=false：只建立顺序依赖，【不】把插件 dll 当作 App 的编译/运行时引用，
               因此不会进入 PublishSingleFile 的单文件包，也不改变插件按 ALC 隔离加载的形态。
             · Private=false：即便误加引用也不本地复制，双保险。
             · 不改 DeployPluginsToOutput 的语义（plugins/ 仍是唯一部署源，loader 扫描位置不变）。
             · 连带收益：单独 `dotnet build/publish src/DesktopPet.App` 现在也会先把全部内置插件构建并部署好，
               不再依赖「先构建过 sln」的隐含前置。
       注：本机 22 次连续构建（A/B 对照，含强制重建）未复现 MSB3030，故此改动为【按构造根治】，
           以本机多次连续全绿 + 功能回归（LoaderTest / PluginSmoke 18/18 alc 全 Y / 真机 18 插件）验证。
       =============================================================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Affection\DesktopPet.Builtin.Affection.csproj"                 ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Bazi\DesktopPet.Builtin.Bazi.csproj"                             ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.ClipboardHistory\DesktopPet.Builtin.ClipboardHistory.csproj"     ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.ColorPicker\DesktopPet.Builtin.ColorPicker.csproj"               ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Countdown\DesktopPet.Builtin.Countdown.csproj"                   ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Fortune\DesktopPet.Builtin.Fortune.csproj"                       ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.HourlyChime\DesktopPet.Builtin.HourlyChime.csproj"               ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.MusicControl\DesktopPet.Builtin.MusicControl.csproj"             ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Notes\DesktopPet.Builtin.Notes.csproj"                           ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Pomodoro\DesktopPet.Builtin.Pomodoro.csproj"                     ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.QuickSearch\DesktopPet.Builtin.QuickSearch.csproj"               ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Quote\DesktopPet.Builtin.Quote.csproj"                           ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Screenshot\DesktopPet.Builtin.Screenshot.csproj"                 ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.SleepReminder\DesktopPet.Builtin.SleepReminder.csproj"           ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.SystemInfo\DesktopPet.Builtin.SystemInfo.csproj"                 ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.TodoList\DesktopPet.Builtin.TodoList.csproj"                     ReferenceOutputAssembly="false" Private="false" />
