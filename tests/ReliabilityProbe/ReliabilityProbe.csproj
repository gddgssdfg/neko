<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DesktopPet.App/DesktopPet.App.csproj" />
    <None Include="../../neko-assets/amber/*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets/amber" />
    <None Include="../../neko-assets/amber/skin.json" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets/amber" />
    <None Include="../../neko-assets/pixel/*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets/pixel" />
  </ItemGroup>
</Project>
