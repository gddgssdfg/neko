<Project Sdk="Microsoft.NET.Sdk">

  <!-- QA 独立证伪夹具（v0.1.82 / software-qa-engineer-2）。
       目的：把 Bazi 插件「手写 Utf8JsonWriter 路径」的输出与「旧版 STJ 反射默认路径」的输出
       **逐字节比对**，并验证 ChatHistory 向后兼容与畸形输入健壮性。
       只读地用反射调用插件内部方法，绝不修改插件源码。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>BaziJsonDiff</AssemblyName>
    <RootNamespace>BaziJsonDiff</RootNamespace>
    <!-- 本夹具是一次性诊断工具，不进发布产物 -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\builtins\DesktopPet.Builtin.Bazi\DesktopPet.Builtin.Bazi.csproj" />
    <ProjectReference Include="..\..\src\DesktopPet.Core\DesktopPet.Core.csproj" />
  </ItemGroup>

</Project>
