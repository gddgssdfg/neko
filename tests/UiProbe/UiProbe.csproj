<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UiProbe</AssemblyName>
    <RootNamespace>DesktopPet.Tests.UiProbe</RootNamespace>
    <!-- v0.1.82：**不要**再写 SelfContained。
         v0.1.61 曾因「App 自 v0.1.60 起是自包含」而对齐设为 SelfContained=true（避 NETSDK1151：
         非自包含 exe 不能引用自包含 exe）。v0.1.82 把 App 的 SelfContained 换成了
         PublishSelfContained（因为 SelfContained 是**构建期**属性，会让 Debug 也产出自包含形态，
         而该形态下 AssemblyDependencyResolver 失败 → 插件全加载不了），
         于是 App 的 Debug 产物变回**非自包含**，方向反过来：自包含的 UiProbe 不能引用
         非自包含的 App（NETSDK1150）。故这里去掉 SelfContained，与 App 保持一致。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.App\DesktopPet.App.csproj" />
    <!-- 素材是 <None> 项，不会随项目引用传递，需显式复制到本测试输出目录。
         v0.1.78 P2-3：改白名单，与 DesktopPet.App.csproj 同步（测试要能扫到 icons/mirror/pixel/soft + tray.ico）；
         不再全量复制 **\*.png，避免 _icon_*、*preview*、reference\ 等开发噪声进测试输出。
         ⚠️ v0.1.80 P0 修复：LinkBase 必须含子目录（neko-assets\icons…），否则 MSBuild 会
         按「通配符基准目录」计算 %(RecursiveDir) 而把 icons\book.png 摊平到 neko-assets\book.png，
         导致 SkinRegistry 扫不到 <skin>/skin.json、RadialMenu 找不到 icons\ → UiProbe 素材断言全红。 -->
    <None Include="..\..\neko-assets\icons\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\icons" />
    <None Include="..\..\neko-assets\mirror\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\mirror" />
    <None Include="..\..\neko-assets\pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixel" />
    <None Include="..\..\neko-assets\soft\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\soft" />
    <!-- v0.1.81：AI 高清皮肤（与 App 侧同步） -->
    <None Include="..\..\neko-assets\hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\hd" />
    <None Include="..\..\neko-assets\pixelai\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\pixelai" />
    <None Include="..\..\neko-assets\cat_pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\cat_pixel" />
    <None Include="..\..\neko-assets\cat_hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\cat_hd" />
    <None Include="..\..\neko-assets\phoebe_pixel\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\phoebe_pixel" />
    <None Include="..\..\neko-assets\phoebe_hd\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\phoebe_hd" />
    <!-- 拼豆皮肤（第 9 套）：与 App 侧 DesktopPet.App.csproj 同步——只复制运行时素材
         （*.png + skin.json），排除构建期源模型 bead/model/*.beads.json。 -->
    <None Include="..\..\neko-assets\bead\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\bead" />
    <None Include="..\..\neko-assets\bead\skin.json" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\bead" />
    <None Include="..\..\neko-assets\ui\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets\ui" />
    <None Include="..\..\neko-assets\tray.ico" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets" />
    <None Remove="..\..\neko-assets\**\*preview*" />
    <None Remove="..\..\neko-assets\**\*.bak-*" />
    <!-- v0.1.46：插件目录同样复制到测试输出（Plugins.LoadCore 依赖 BaseDirectory/plugins/） -->
    <None Include="..\..\plugins\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="plugins" />
  </ItemGroup>

</Project>
