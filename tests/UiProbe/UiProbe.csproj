<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UiProbe</AssemblyName>
    <RootNamespace>DesktopPet.Tests.UiProbe</RootNamespace>
    <!-- v0.1.82：**不要**再写 SelfContained。
         v0.1.61 曾因「App 自 v0.1.60 起是自包含」而对齐设为 SelfContained=true（避 NETSDK1151：
         非自包含 exe 不能引用自包含 exe）。v0.1.82 把 App 的 SelfContained 换成了
         PublishSelfContained（因为 SelfContained 是**构建期**属性，会让 Debug 也产出自包含形态，
         而该形态下 AssemblyDependencyResolver 失败 → 插件全加载不了），
         于是 App 的 Debug 产物变回**非自包含**，方向反过来：自包含的 UiProbe 不能引用
         非自包含的 App（NETSDK1150）。故这里去掉 SelfContained，与 App 保持一致。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\src\DesktopPet.App\DesktopPet.App.csproj" />
    <!-- v0.1.46：插件目录同样复制到测试输出（Plugins.LoadCore 依赖 BaseDirectory/plugins/） -->
    <None Include="..\..\plugins\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="plugins" />
  </ItemGroup>

  <Import Project="..\..\build\RuntimeAssets.props" />
</Project>
