<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UiProbe</AssemblyName>
    <RootNamespace>DesktopPet.Tests.UiProbe</RootNamespace>
    <!-- v0.1.61：App 自 v0.1.60 起为自包含（SelfContained=true + RID=win-x64）。
         非自包含 exe 不能引用自包含 exe（NETSDK1151），故测试侧对齐为自包含。
         仅影响测试产物，不改动 App 的发布配置。 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopPet.App\DesktopPet.App.csproj" />
    <!-- 素材是 <None> 项，不会随项目引用传递，需显式复制到本测试输出目录 -->
    <None Include="..\..\neko-assets\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="neko-assets" />
    <!-- v0.1.46：插件目录同样复制到测试输出（Plugins.LoadCore 依赖 BaseDirectory/plugins/） -->
    <None Include="..\..\plugins\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="plugins" />
  </ItemGroup>

</Project>
